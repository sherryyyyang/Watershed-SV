    duplicates = [col for col in columns if columns.count(col) > 1]
    print("DEBUG: Columns before aggregation:", columns)
    print("DEBUG: Duplicate columns before aggregation:", duplicates)

    df_columns_lower = set(
        uncollapsed_dataset_with_MAF_length_CN_agg.collect_schema().names()
    )
    collapse_modified = {
        key: val for key, val in collapse_modified.items() if key in df_columns_lower
    }
    print("DEBUG: Columns being aggregated:", list(collapse_modified.keys()))

    collapsed_complete_dataset = (
        uncollapsed_dataset_with_MAF_length_CN_agg.drop(["sv"] + y_columns)
        .group_by(["subjectid", "gene_id"])
        .agg(
            [
                (
                    pl.col(col).max().alias(col)
                    if method == "max"
                    else (
                        pl.col(col).min().alias(col)
                        if method == "min"
                        else (
                            pl.when(pl.col(col).is_null().any())
                            .then(pl.col(col).n_unique() - 1)
                            .otherwise(pl.col(col).n_unique())
                            .alias(col)
                            if method == "nunique"
                            else (
                                pl.when(
                                    col in ["ase_pvalue", "te_pvalue", "se_pvalue", "apa_pvalue"]
                                )
                                .then(pl.col(col).first())
                                .otherwise(pl.col(col).sum())
                                .alias(col)
                                if col.endswith("_pvalue")
                                else (
                                    pl.col(col).first().alias(col)
                                    if method == "first"
                                    else (
                                        pl.when(
                                            pl.col(col).max().abs()
                                            > pl.col(col).min().abs()
                                        )
                                        .then(pl.col(col).max())
                                        .otherwise(pl.col(col).min())
                                        .alias(col)
                                        if col == "dcn"
                                        else (
                                            pl.col(col).sum().alias(col)
                                            if "is_abc_sv" in col
                                            else pl.col(col).max().alias(col)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
                for col, method in collapse_modified.items()
            ]
        )
    )

    collapsed_complete_dataset = collapsed_complete_dataset.with_columns(
        cs.starts_with("te_pvalue").map_batches(
