    qualified_expression_protein_coding = median_expression_df_protein_coding.filter(
        functools.reduce(
            lambda x, y: x | y,
            [
                pl.col(f"{mod}_tissue_count") >= args.minimum_support_tissue_count
                for mod in modalities
            ],
        )
    )

