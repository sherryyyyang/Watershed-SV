    print("DEBUG: gene_sv shape:", gene_sv.collect().shape)
    print("DEBUG: gene_sv sample:", gene_sv.collect().head())
    expression_df_protein_coding = expression_df_protein_coding.with_columns(
        [
            pl.col("gene_id").cast(pl.Utf8),
            pl.col("subjectid").cast(pl.Utf8),
        ]
    )

    # Join with gene_sv and expression data
    noBND_SV_Ind_Gene = (
        true_rare_alleles.join(
            gene_sv.select(["gene_id", "sv"]),
            on="sv",
            how="inner",
            coalesce=True,
        )
        .join(
            expression_df_combined,
