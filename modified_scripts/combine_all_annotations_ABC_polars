    expression_df_combined = expression_df_combined.with_columns(outlier_flags)
    print("DEBUG: expression_df_combined", expression_df_combined.collect().head())

    expression_df_protein_coding = (
        qualified_expression_protein_coding.lazy()
        .join(
            expression_df_combined.with_columns(
                [pl.col("gene_id").str.split(".").list.first()]
            ),
            how="left",
            on=["gene_id", "subjectid"],
            coalesce=True,
        )
        .with_columns(
            [
                pl.when(
                    pl.col(f"{mod}_median_outlier").cast(pl.Float64).abs()
                    > args.zscore_threshold
                )
                .then(1)
                .otherwise(0)
