    else:
        rare_maf_frame = maf_frame.filter(pl.col("af") >= 0)

    true_rare_alleles = genotypes.filter(pl.col("allele") > 0).join(
        rare_maf_frame.select("sv"), on="sv", how="inner", coalesce=True
    )

    print("DEBUG: true_rare_alleles shape:", true_rare_alleles.collect().shape)
    print("DEBUG: true_rare_alleles sample:", true_rare_alleles.collect().head())

    true_rare_alleles = true_rare_alleles.with_columns(
        [
