        elif col.endswith("_tes_flank_tes_flank"):
            rename_map[col] = col.replace("_tes_flank_tes_flank", "_tes_flank")
        elif col.endswith("_tss_flank_tss_flank"):
            rename_map[col] = col.replace("_tss_flank_tss_flank", "_tss_flank")
    if rename_map:
        collapsed_complete_dataset = collapsed_complete_dataset.rename(rename_map)

    cols_to_drop = [
        col
        for col in collapsed_complete_dataset.collect_schema().names()
        if col.endswith("_is_abc_sv")
    ]
    if cols_to_drop:
        collapsed_complete_dataset = collapsed_complete_dataset.drop(cols_to_drop)
    collapsed_complete_dataset.write_csv(args.outfile, separator="\t")

    collapsed_df = collapsed_complete_dataset.to_pandas()
    null_cols = [
        col for col in collapsed_df.columns if collapsed_df[col].isnull().all()
    ]
