def extract_MAF(vcf_path, field):
    additional_SV_info = []
    vcf_read = VariantFile(vcf_path, "r")
    for rec in vcf_read.fetch():
        additional_SV_info.append([rec.id, rec.info[field]])
    return pd.DataFrame(additional_SV_info, columns=["SV", field])


def extract_length(vcf_path, field="SVLEN"):
    additional_SV_info = []
    vcf_read = VariantFile(vcf_path, "r")
    for rec in vcf_read.fetch():
        if rec.info["SVTYPE"] != "BND":
            if rec.info["SVTYPE"] == "LINE1":
                if isinstance(rec.info["SVLEN"], int):
                    if rec.info["SVLEN"] != -1:
                        additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                    else:
                        additional_SV_info.append(
                            [rec.id, abs(int(rec.info["MEINFO"][2]))]
                        )
                else:
                    if rec.info["SVLEN"][0] != -1:
                        additional_SV_info.append(
                            [rec.id, abs(int(rec.info["SVLEN"][0]))]
                        )
                    else:
                        additional_SV_info.append(
                            [rec.id, abs(int(rec.info["MEINFO"][2]))]
                        )
            elif rec.info["SVTYPE"] == "MEI":
                if isinstance(rec.info["SVLEN"], int):
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                else:
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"][0]))])
            elif rec.info["SVTYPE"] == "SVA":
                if isinstance(rec.info["SVLEN"], int):
                    svlen = abs(int(rec.info["SVLEN"]))
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                else:
                    svlen = abs(int(rec.info["SVLEN"][0]))
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"][0]))])
            elif rec.info["SVTYPE"] == "ALU":
                if isinstance(rec.info["SVLEN"], int):
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                else:
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"][0]))])
            elif rec.info["SVTYPE"] == "BND":
                additional_SV_info.append([rec.id, -1])
            elif "CNV" in rec.info["SVTYPE"]:
                if "SVLEN" in rec.info:
                    if isinstance(rec.info["SVLEN"], int):
                        additional_SV_info.append(
                            [rec.id + ".DUP_CNV", abs(int(rec.info["SVLEN"]))]
                        )
                        additional_SV_info.append(
                            [rec.id + ".DEL_CNV", abs(int(rec.info["SVLEN"]))]
                        )
                    else:
                        additional_SV_info.append(
                            [rec.id + ".DUP_CNV", abs(int(rec.info["SVLEN"][0]))]
                        )
                        additional_SV_info.append(
                            [rec.id + ".DEL_CNV", abs(int(rec.info["SVLEN"][0]))]
                        )
                else:
                    additional_SV_info.append(
                        [rec.id + ".DUP_CNV", abs(rec.stop - rec.pos)]
                    )
                    additional_SV_info.append(
                        [rec.id + ".DEL_CNV", abs(rec.stop - rec.pos)]
                    )
            elif rec.info["SVTYPE"] == "DEL":
                if isinstance(rec.info["SVLEN"], int):
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                else:
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"][0]))])
            else:
                if isinstance(rec.info["SVLEN"], int):
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"]))])
                else:
                    additional_SV_info.append([rec.id, abs(int(rec.info["SVLEN"][0]))])

    return pd.DataFrame(additional_SV_info, columns=["SV", field])


def ensure_lazy_frame(data):
    """Ensure the input is a Polars lazy frame."""
    if isinstance(data, pl.DataFrame):
        return data.lazy()
    elif isinstance(data, pl.LazyFrame):
        return data
    else:
        raise ValueError("Input must be a Polars DataFrame or LazyFrame.")


def standardize_column_names(df):
    """Standardize column names to ensure consistency and strip gene_id version."""
    df = df.rename(
        {col: col.lower().replace(" ", "_").replace("-", "_") for col in df.columns}
    )
    if "gene_id" in df.columns:
        # Strip version from gene_id (keep only before first dot)
        df = df.with_columns(
            pl.col("gene_id").str.split(".").list.first().alias("gene_id")
        )
    return df


def read_and_standardize(
    file_name, column_mapping=None, annotation_dir=None, flank=None, suffix="", **kwargs
):
    """Read a file into a Polars lazy frame, determine subdirectory and suffix dynamically, and standardize column names."""
    schema_overrides = kwargs.pop("schema_overrides", {})

    # Determine subdirectory and suffix if annotation_dir and flank are provided
    if annotation_dir and flank:
        genebody_dir = os.path.join(annotation_dir, "intermediates")
        tssFlank_dir = os.path.join(annotation_dir, "intermediates_tss_flank")
        tesFlank_dir = os.path.join(annotation_dir, "intermediates_tes_flank")

        if f"gene_sv_slop.{flank}.bed" in file_name:
            subdirectory, suffix = genebody_dir, "_slop"
        elif f"gene_sv.{flank}.bed" in file_name:
            raise ValueError(
                "Ambiguous file name. Explicitly specify the subdirectory."
            )
        else:
            raise ValueError(f"Unknown file name pattern: {file_name}")
        file_path = os.path.join(subdirectory, file_name)
    else:
        file_path = file_name

    # Read the file and standardize column names

    df = ensure_lazy_frame(
        pl.scan_csv(file_path, schema_overrides=schema_overrides, **kwargs)
    )
    df = standardize_column_names(df)
    if column_mapping:
        actual_mapping = {
            k: v for k, v in column_mapping.items() if k in df.collect_schema().names()
        }
        df = df.rename(actual_mapping)
    if suffix:
        df = df.select(
            [
                pl.col(["gene_id", "sv"]),
                pl.all().exclude(["gene_id", "sv"]).name.suffix(suffix),
            ]
        )
    return df


def process_annotations(annotation_files, suffix):
    """Process annotation files and merge them with a suffix."""
    annotations = [
        ensure_lazy_frame(
            pl.scan_csv(file, separator="\t", schema_overrides={"sv": str})
        )
        for file in annotation_files
    ]
    merged_annotations = annotations[0]
    for annot in annotations[1:]:
        merged_annotations = merged_annotations.join(
            annot, how="full", on=["gene_id", "sv"], coalesce=True
        )
    return merged_annotations.select(
        [
            pl.col(["gene_id", "sv"]),
            pl.all().exclude(["gene_id", "sv"]).name.suffix(suffix),
        ]
    )


